# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRAVA_CLIENT_ID: Your Strava API application client ID.
# Create or find your app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID="YOUR_STRAVA_CLIENT_ID"

# STRAVA_CLIENT_SECRET: Your Strava API application client secret.
# NEVER expose this to the browser -- used server-side only.
STRAVA_CLIENT_SECRET="YOUR_STRAVA_CLIENT_SECRET"

# ─────────────────────────────────────────────────────────────────────
# Firebase (Admin auth + content storage)
# ─────────────────────────────────────────────────────────────────────
# Create/select a Firebase project at https://console.firebase.google.com
# then enable Firestore, Storage, and Authentication (Email/Password).
# Copy the web app config values below.
#
# VITE_FIREBASE_API_KEY="AIza..."
# VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project"
# VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
# VITE_FIREBASE_APP_ID="1:123456789:web:abc123"
#
# Set to "true" to use local Firebase Emulator Suite.
# VITE_FIREBASE_EMULATOR="false"
#
# Toggle to "true" to pull content from Firestore instead of mock data.
# VITE_USE_FIREBASE_CONTENT="false"
